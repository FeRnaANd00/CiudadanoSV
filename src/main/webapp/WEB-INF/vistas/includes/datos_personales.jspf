<%-- Datos personales de una cuenta (los edita la propia persona en "Mi perfil"). Requiere ${cuenta}. --%>
<h3 class="text-label-md text-primary mt-4 flex items-center gap-1"><span class="material-symbols-outlined text-[18px]">person</span> Datos personales</h3>
<dl class="mt-2 grid gap-3 sm:grid-cols-2">
  <div><dt class="text-caption uppercase text-secondary">Fecha de nacimiento</dt><dd class="text-label-md">${empty cuenta.fechaNacimientoTexto ? '—' : cuenta.fechaNacimientoTexto}</dd></div>
  <div><dt class="text-caption uppercase text-secondary">Estado civil</dt><dd class="text-label-md">${empty cuenta.estadoCivilTexto ? '—' : cuenta.estadoCivilTexto}</dd></div>
  <div class="sm:col-span-2"><dt class="text-caption uppercase text-secondary">Residencia (distrito, municipio, departamento)</dt><dd class="text-label-md"><c:out value="${empty cuenta.residenciaTexto ? '—' : cuenta.residenciaTexto}"/></dd></div>
  <div class="sm:col-span-2"><dt class="text-caption uppercase text-secondary">Dirección</dt><dd class="text-label-md"><c:out value="${empty cuenta.direccion ? '—' : cuenta.direccion}"/></dd></div>
</dl>
